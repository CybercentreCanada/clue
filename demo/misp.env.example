MISP_API_KEY=your-api-key-here
API_URL=https://your-misp-instance
MISP_VERIFY=true

# Allow tags filters out tags from annoation result via an allow list
# Append to default allow list
ALLOW_TAGS_EXTRA="misp:threat-level,cert-ist:threat_targeted_system"
# Override
#ALLOW_TAGS="misp:threat-level,cert-ist:threat_targeted_system"
